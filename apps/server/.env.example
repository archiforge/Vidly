# Copy to .env and adjust. Every value is optional in development.

NODE_ENV=development
PORT=3900
MONGODB_URI=mongodb://127.0.0.1:27017/vidly

# Required in production: a long random string (>= 32 chars), e.g. `openssl rand -base64 48`.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Allow self-service sign-up of staff accounts from the portal.
ALLOW_REGISTRATION=true

# Optional: create (or promote) this admin account on startup if it doesn't exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional: comma-separated origins allowed to call the API cross-origin.
# Not needed in development (Vite proxies /api) or when the server hosts the client.
CORS_ORIGIN=

# Number of reverse proxies in front of the app (for correct client IPs / rate limiting).
TRUST_PROXY=0

LOG_LEVEL=info
